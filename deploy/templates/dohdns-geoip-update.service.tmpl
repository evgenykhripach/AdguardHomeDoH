[Unit]
Description=Update DoHDNS RU GeoIP database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/dohdns/update-geoip.sh --root /
ExecStartPost=/usr/local/libexec/dohdns/validate-mmdb.sh --path /var/lib/dohdns/geoip/Country-without-asn.mmdb
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/dohdns/geoip
