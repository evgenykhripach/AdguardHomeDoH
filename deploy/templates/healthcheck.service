[Unit]
Description=AdGuard Home DoH health gate
After=network-online.target nginx.service adguardhome-doh.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/adguardhome-doh/healthcheck.py
EnvironmentFile=/etc/adguardhome-doh/runtime.env
User=root
Group=root
RuntimeDirectory=adguardhome-doh
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# ProtectSystem=strict mounts /run read-only as well, so the run lock needs an
# explicit exception; without it every cycle fails before probing anything.
ReadWritePaths=/var/lib/adguardhome-doh /run/lock
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallArchitectures=native
TimeoutStartSec=180s

[Install]
WantedBy=multi-user.target
