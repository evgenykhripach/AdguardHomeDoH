# Generated by tools/render_deployment.py.  HTTPS is passed through to sniproxy.
server {
    listen {{ bind_public }}:80;
    server_name {{ hostname }};
    access_log off;
    error_log /var/log/nginx/{{ hostname }}.error.log warn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        try_files $uri =404;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}
