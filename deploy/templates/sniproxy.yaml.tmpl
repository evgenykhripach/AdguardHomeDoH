# Generated by tools/render_deployment.py for sniproxy v2.3.0.
general:
  upstream_dns: https://cloudflare-dns.com/dns-query
  upstream_dns_over_socks5: false
  upstream_socks5:
  bind_dns_over_udp: "0.0.0.0:53"
  bind_dns_over_tcp: "0.0.0.0:53"
  bind_dns_over_tls: "0.0.0.0:853"
  bind_dns_over_quic: ""
  tls_cert: /etc/sniproxy/tls/fullchain.pem
  tls_key: /etc/sniproxy/tls/privkey.pem
  # sniproxy parses bind_http unconditionally; keep its internal HTTP listener non-empty.
  bind_http: "127.0.0.1:8081"
  bind_http_additional:
  bind_https: "0.0.0.0:443"
  bind_https_additional:
  prometheus: "127.0.0.1:9090"
  interface:
  preferred_version: ipv4only
  public_ipv4: "{{ ipv4 }}"
  public_ipv6: ""
  allow_conn_to_local: false
  log_level: warn
acl:
  # Lower values are evaluated first. GeoIP remains final so reject cannot be
  # undone by the domain or DoH override ACL.
  domain:
    enabled: true
    priority: 10
    path: /etc/sniproxy/current/domains.csv
    refresh_interval: 1h0m0s
  override:
    enabled: true
    priority: 20
    rules: {}
    doh_sni: "{{ hostname }}"
    tls_cert: /etc/sniproxy/tls/fullchain.pem
    tls_key: /etc/sniproxy/tls/privkey.pem
  geoip:
    enabled: true
    priority: 100
    blocked:
    # PRIVATE is only for the internal loopback DoH-to-DNS path.
    allowed: [RU, PRIVATE]
    path: /var/lib/dohdns/geoip/Country-without-asn.mmdb
    refresh_interval: 24h0m0s
