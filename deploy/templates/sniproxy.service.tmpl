[Unit]
Description=DoHDNS sniproxy
After=network-online.target systemd-resolved.service dohdns-nftables.service
Wants=network-online.target
Requires=dohdns-nftables.service
RequiresMountsFor=/etc/sniproxy /var/lib/dohdns

[Service]
Type=simple
User=sniproxy
Group=sniproxy
RuntimeDirectory=sniproxy
Environment=NO_COLOR=true
ExecStartPre=/usr/local/libexec/dohdns/validate-mmdb.sh --path /var/lib/dohdns/geoip/Country-without-asn.mmdb
ExecStartPre=/usr/local/libexec/dohdns/sync-cert.sh --root / --check
ExecStart=/usr/local/libexec/sniproxy/current/sniproxy --config /etc/sniproxy/current/sniproxy.yaml
Restart=on-failure
RestartSec=2s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/var/lib/dohdns /run/sniproxy

[Install]
WantedBy=multi-user.target
